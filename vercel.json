{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "job-assistant": {
      "runtime": "container",
      "root": ".",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "job-assistant" }
    }
  ]
}
