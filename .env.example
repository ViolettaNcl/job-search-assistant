POSTGRES_PASSWORD=replace-with-a-long-random-password
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=0

# HeadHunter applicant OAuth (optional until the HH developer app is approved)
HH_ENABLED=true
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8080/api/hh/oauth/callback

# International search. Remotive works without a key.
REMOTIVE_ENABLED=true

# Adzuna: register at https://developer.adzuna.com/ to receive app_id/app_key.
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=us,gb,de,ca,au,fr,nl,pl

ENCRYPTION_KEY_BASE64=
ENABLE_AUTOMATIC_SUBMISSION=false
