{
  "manifest_version": 3,
  "name": "Violetta Apply Assistant",
  "version": "0.1.0",
  "description": "Analyze a vacancy, prepare a truthful tailored application and autofill common job application fields.",
  "permissions": ["activeTab", "storage", "clipboardWrite"],
  "host_permissions": ["http://localhost:8080/*", "https://*/*", "http://*/*"],
  "action": {
    "default_title": "Violetta Apply Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
