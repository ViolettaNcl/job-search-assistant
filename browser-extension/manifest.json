{
  "manifest_version": 3,
  "name": "Violetta Apply Assistant",
  "version": "2.0.0",
  "description": "Prepare and review applications safely, verify setup readiness, record verified submissions, and surface due recruiter follow-ups without sending outreach automatically.",
  "permissions": ["activeTab", "storage", "unlimitedStorage", "clipboardWrite"],
  "host_permissions": ["http://localhost:8080/*", "https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Violetta Apply Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["ats-structured.js", "ats-controls.js", "field-verification.js", "content.js", "cv-upload.js", "review-navigator-content.js", "final-submit-control.js", "final-submit-locator.js", "submission-receipt.js", "submission-receipt-content.js"],
      "run_at": "document_idle"
    }
  ]
}
