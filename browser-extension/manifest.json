{
  "manifest_version": 3,
  "name": "Violetta Apply Assistant",
  "version": "0.2.0",
  "description": "Analyze vacancies, prepare truthful tailored applications, reuse confirmed answers and safely autofill common ATS fields.",
  "permissions": ["activeTab", "storage", "clipboardWrite"],
  "host_permissions": ["http://localhost:8080/*", "https://*/*", "http://*/*"],
  "action": {
    "default_title": "Violetta Apply Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
