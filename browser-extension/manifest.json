{
  "manifest_version": 3,
  "name": "Violetta Apply Assistant",
  "version": "0.8.0",
  "description": "Analyze vacancies, verify safe ATS autofill, automatically refresh submission readiness and insert the recommended stored CV.",
  "permissions": ["activeTab", "storage", "unlimitedStorage", "clipboardWrite"],
  "host_permissions": ["http://localhost:8080/*", "https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Violetta Apply Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["ats-structured.js", "ats-controls.js", "field-verification.js", "content.js", "cv-upload.js"],
      "run_at": "document_idle"
    }
  ]
}
